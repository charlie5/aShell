with
     "ashell",
     "ashell_shared",
     "lib_florist";

-- Adds task safe commands ('Shell.Commands.Safe') to aShell. Programs using it need the spawn server on their PATH.
--
project aShell_Safe
is
   for Create_Missing_Dirs use "True";

   for Object_Dir  use aShell_Shared.object_Dir;
   for Source_Dirs use ("source");


   package Builder  renames aShell_Shared.Builder;
   package Compiler renames aShell_Shared.Compiler;
   package Binder   renames aShell_Shared.Binder;

   package IDE is
      for VCS_Kind use "Git";
   end IDE;

end aShell_Safe;
