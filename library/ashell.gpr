with
     "lib_florist",
     "ashell_shared";

project aShell
is
   for Create_Missing_Dirs use "True";

   for Object_Dir  use aShell_Shared.object_Dir;
   for Source_Dirs use ("source",
                        "source/private");


   package Builder  renames aShell_Shared.Builder;
   package Compiler renames aShell_Shared.Compiler;
   package Binder   renames aShell_Shared.Binder;

   package IDE is
      for VCS_Kind use "Git";
   end IDE;

end aShell;
